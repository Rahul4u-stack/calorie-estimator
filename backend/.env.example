# Calorie Estimator — Backend Environment Variables
# -------------------------------------------------------
# Copy this file to .env and fill in your real values:
#   cp .env.example .env
#
# NEVER commit your .env file to GitHub — it contains secrets!
# -------------------------------------------------------

# Your Anthropic API key — get one at https://console.anthropic.com/
# It should start with: sk-ant-
ANTHROPIC_API_KEY=your_api_key_here

# Flask environment — use "development" locally, "production" on the server
FLASK_ENV=development

# Port the backend server runs on
PORT=5000

# URL of the frontend (used for CORS in development)
FRONTEND_URL=http://localhost:5173
